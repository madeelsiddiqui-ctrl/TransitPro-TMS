digraph ERD { graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1.1, label=<<font face="Helvetica-Bold" point-size="18">Transport Management System — Entity Relationship Diagram</font><br/><font face="Helvetica" point-size="11" color="#64748b">PK = Primary Key · FK = Foreign Key · UQ = Unique · crow's foot = many · Muhammad Adeel Siddiqi · PGD/DSAI/Apr-26/312564</font>>, labelloc=t]; node [shape=plaintext]; edge [color="#475569", penwidth=1.3, fontname="Helvetica", fontsize=10, fontcolor="#1d4ed8"];
customers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#cbd3df"><tr><td colspan="3" bgcolor="#0b1b33"><font face="Helvetica-Bold" color="white" point-size="12">CUSTOMERS</font></td></tr><tr><td align="left" port="customer_id" bgcolor="#eef3ff"><font face="Helvetica" point-size="10" color="#1d4ed8"><b>customer_id</b></font></td><td align="left" bgcolor="#eef3ff"><font face="Helvetica" point-size="9" color="#64748b">INT</font></td><td port="customer_id_r" bgcolor="#eef3ff"><font face="Helvetica" point-size="9" color="#b45309"><b>PK</b></font></td></tr><tr><td align="left" port="full_name" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">full_name</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(100)</font></td><td port="full_name_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr><tr><td align="left" port="company" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">company</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(100)</font></td><td port="company_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr><tr><td align="left" port="phone" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">phone</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(20)</font></td><td port="phone_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"><b>UQ</b></font></td></tr><tr><td align="left" port="email" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">email</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(100)</font></td><td port="email_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"><b>UQ</b></font></td></tr><tr><td align="left" port="city" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">city</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(50)</font></td><td port="city_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr><tr><td align="left" port="address" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">address</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(200)</font></td><td port="address_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr><tr><td align="left" port="created_at" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">created_at</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">TIMESTAMP</font></td><td port="created_at_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr></table>>];
routes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#cbd3df"><tr><td colspan="3" bgcolor="#0b1b33"><font face="Helvetica-Bold" color="white" point-size="12">ROUTES</font></td></tr><tr><td align="left" port="route_id" bgcolor="#eef3ff"><font face="Helvetica" point-size="10" color="#1d4ed8"><b>route_id</b></font></td><td align="left" bgcolor="#eef3ff"><font face="Helvetica" point-size="9" color="#64748b">INT</font></td><td port="route_id_r" bgcolor="#eef3ff"><font face="Helvetica" point-size="9" color="#b45309"><b>PK</b></font></td></tr><tr><td align="left" port="origin" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">origin</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(50)</font></td><td port="origin_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"><b>UQ*</b></font></td></tr><tr><td align="left" port="destination" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">destination</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">VARCHAR(50)</font></td><td port="destination_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"><b>UQ*</b></font></td></tr><tr><td align="left" port="distance_km" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">distance_km</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">DECIMAL(8,2)</font></td><td port="distance_km_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr><tr><td align="left" port="est_hours" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">est_hours</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">DECIMAL(5,2)</font></td><td port="est_hours_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></