tica" point-size="9" color="#64748b">VARCHAR(20)</font></td><td port="status_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr><tr><td align="left" port="freight_charge" bgcolor="white"><font face="Helvetica" point-size="10" color="#0f1b2d">freight_charge</font></td><td align="left" bgcolor="white"><font face="Helvetica" point-size="9" color="#64748b">DECIMAL(12,2)</font></td><td port="freight_charge_r" bgcolor="white"><font face="Helvetica" point-size="9" color="#b45309"> </font></td></tr></table>>];
